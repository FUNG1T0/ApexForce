NODE_ENV=development
PORT=3000

POSTGRES_DB=apexforce
POSTGRES_USER=apexforce
POSTGRES_PASSWORD=replace_with_a_local_only_password
DATABASE_URL=postgresql://apexforce:replace_with_a_local_only_password@localhost:5432/apexforce

# Use at least 32 random bytes. Never commit the real value.
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1h

# Set these only when bootstrapping the first administrator.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
